# 자체 개발 커스텀 프록시 엔드포인트
LOCAL_ENDPOINT=http://localhost:8080/v1/chat/completions
AGENT_MODEL=claude-sonnet
AGENT_MAX_TOKENS=4096
PASS_THRESHOLD=8.0
MAX_RETRIES=3
REQUEST_TIMEOUT=120

# Discord Webhook (미설정 시 터미널 출력만 사용)
DISCORD_WEBHOOK_URL=

# AI 세션 키 (각 PC에서 직접 추출)
CLAUDE_SESSION_KEY=
GEMINI_PSID=
GEMINI_PSIDTS=
CHATGPT_SESSION_TOKEN=
